<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1">
    <title>ra1n IME</title>
    <organization>kr.ra1n</organization>
    <domains enable_localSystem="true"/>
    <options customize="never" allow-external-scripts="no" rootVolumeOnly="true"/>

    <conclusion>
        <title>설치 완료</title>
        <message>ra1n IME 설치가 완료되었습니다.&#x0a;&#x0a;입력기를 정상적으로 사용하려면 재로그인이 필요합니다. 아래의 [Log Out] 버튼을 눌러 지금 바로 로그아웃하세요.&#x0a;&#x0a;로그인 후 시스템 설정 → 키보드 → 입력 소스에서 ra1n IME를 추가해주세요.</message>
    </conclusion>

    <pkg-ref id="kr.ra1n.inputmethod.ra1nime" version="__VERSION__" onConclusion="RequireLogout">component.pkg</pkg-ref>

    <choices-outline>
        <line choice="default">
            <line choice="kr.ra1n.inputmethod.ra1nime"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="kr.ra1n.inputmethod.ra1nime" visible="false">
        <pkg-ref id="kr.ra1n.inputmethod.ra1nime"/>
    </choice>
</installer-gui-script>
