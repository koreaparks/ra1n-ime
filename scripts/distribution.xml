<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1">
    <title>ra1n IME</title>
    <organization>kr.ra1n</organization>
    <domains enable_localSystem="true"/>
    <options customize="never" allow-external-scripts="no" rootVolumeOnly="true"/>

    <conclusion>
        <title>설치 완료</title>
        <message>ra1n IME 설치가 완료되었습니다.&#x0a;&#x0a;화면에 나타나는 [ra1n IME 설정 도우미] 창의 안내를 따라 권한을 허용하고 재로그인해주세요.&#x0a;&#x0a;도우미 창이 보이지 않으면 이 설치 관리자를 닫아주세요.</message>
    </conclusion>

    <pkg-ref id="kr.ra1n.inputmethod.ra1nime" version="__VERSION__">component.pkg</pkg-ref>

    <choices-outline>
        <line choice="default">
            <line choice="kr.ra1n.inputmethod.ra1nime"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="kr.ra1n.inputmethod.ra1nime" visible="false">
        <pkg-ref id="kr.ra1n.inputmethod.ra1nime"/>
    </choice>
</installer-gui-script>
