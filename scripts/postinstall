#!/bin/bash
# best-effort 후처리 — 여기서 어떤 단계가 실패해도 설치 자체는 성공으로 끝나야 한다.
# 따라서 set -e 를 쓰지 않고 각 명령을 개별 가드하며, 마지막에 항상 exit 0 한다.
# (lsregister 가 특정 Mac에서 0이 아닌 값을 반환해 설치가 실패로 표시되던 문제 방지)

LSREGISTER="/System/Library/Frameworks/CoreServices.framework/Versions/A/Frameworks/LaunchServices.framework/Versions/A/Support/lsregister"
"$LSREGISTER" -f "/Library/Input Methods/ra1nIME.app" 2>/dev/null || true

killall TextInputMenuAgent 2>/dev/null || true
killall cfprefsd 2>/dev/null || true

loggedInUser=$(scutil <<< "show State:/Users/ConsoleUser" | awk '/Name :/ && ! /loginwindow/ { print $3 }')

if [ -n "$loggedInUser" ]; then
  uid=$(id -u "$loggedInUser" 2>/dev/null || echo "")
  if [ -n "$uid" ]; then
    launchctl asuser "$uid" osascript -e 'display notification "시스템 설정 → 개인정보 보호 → 입력 모니터링에서 ra1n IME를 활성화해주세요." with title "ra1n IME 권한 필요"' 2>/dev/null || true
  fi
fi

exit 0
